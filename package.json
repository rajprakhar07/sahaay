{
  "name": "sahaay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @sahaay/engine && npm run test -w @sahaay/web",
    "typecheck": "npm run typecheck -w @sahaay/engine",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @sahaay/web",
    "typecheck:all": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
